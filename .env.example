# ========================================================
# AArohan Smart Urban Mobility • Environment Configuration
# Lilongwe, Malawi • Multi-Tier Mobility & Settlement Rail
# ========================================================
PORT=3000
NODE_ENV=production

# Platform Security & Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_here
ADMIN_INITIAL_PASSWORD=your_initial_admin_password_here

# --------------------------------------------------------
# 1. Mapbox & Mapping Provider Configuration
# --------------------------------------------------------
# Map Provider: 'mapbox' (default production), 'carto', or 'maptiler'
MAP_PROVIDER=mapbox
MAP_API_KEY=your_mapbox_public_token_here
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here
# Secret token (starts with sk.) used only by the server for street names and road routes. Lets you lock the public token to your website.
MAPBOX_SERVER_TOKEN=
MAPTILER_API_KEY=

# --------------------------------------------------------
# 2. Supabase PostgreSQL & Connection Pooling
# --------------------------------------------------------
# Transaction pooler port 6543 (used by Prisma Client runtime)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection port 5432 (used by Prisma migrate)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Platform Keys
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --------------------------------------------------------
# 2. Airtel Money Malawi (Airtel Africa OpenAPI v2)
# --------------------------------------------------------
# Production Base: https://openapi.airtel.africa
# Sandbox UAT Base: https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_MERCHANT_ID=
AIRTEL_MONEY_WEBHOOK_SECRET=
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa

# --------------------------------------------------------
# 3. TNM Mpamba Malawi Integration
# --------------------------------------------------------
# Open API endpoint for collections and disbursements
# Production Base: https://api.mpamba.tnm.co.mw
TNM_MPAMBA_API_KEY=
TNM_MPAMBA_MERCHANT_CODE=
TNM_MPAMBA_WEBHOOK_SECRET=
TNM_MPAMBA_BASE_URL=https://api.mpamba.tnm.co.mw

# --------------------------------------------------------
# 4. Out-of-Band SMS & WhatsApp Messaging Gateway
# --------------------------------------------------------
# Supported Providers: 'simulator', 'twilio', 'africastalking', 'tnm'
SMS_GATEWAY_PROVIDER=simulator

# Twilio SMS / WhatsApp Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Africa's Talking Credentials (Pan-African SMS Gateway)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=AAROHAN

# TNM Malawi SMS Gateway
TNM_SMS_API_KEY=
TNM_SMS_SENDER_ID=AAROHAN
TNM_SMS_BASE_URL=https://smsapi.tnm.co.mw/v1/sms/send

# --------------------------------------------------------
# 5. Malawi Emergency Hotline & Security Desk
# --------------------------------------------------------
EMERGENCY_POLICE_HOTLINE=997
# REQUIRED in production: a real +265 number that staff answer 24/7 (SOS alerts are sent here).
# The server refuses to start in production without it.
AAROHAN_SECURITY_DESK_PHONE=

# --------------------------------------------------------
# 6. Operations & Data Retention Configuration
# --------------------------------------------------------
# Parcel delivery verification code channel: 'sender' (default: sender sees code in app to share with recipient) or 'sms' (sent via SMS)
PARCEL_CODE_DELIVERY=sender

# Statutory data retention period in months for trip records, GPS breadcrumbs, and support tickets
DATA_RETENTION_MONTHS=12

# --------------------------------------------------------
# 7. Money-safety switches (cash-only pilot)
# --------------------------------------------------------
# Real mobile-money payments and driver payouts are OFF in production unless set to true.
# Leave both false until Airtel/TNM (or a gateway) is approved and tested end to end.
PAYMENTS_ENABLED=false
PAYOUTS_ENABLED=false
# Production always requires a server-signed fare quote. Set true in development/test to enforce the same rule locally.
REQUIRE_FARE_QUOTE=false

# Public contact email shown on the landing page (leave empty to hide it)
CONTACT_EMAIL=

# A driver must have sent a GPS fix within this many seconds to receive ride offers (production default 180)
# DRIVER_GPS_FRESH_SECONDS=180

# --- How people sign in -------------------------------------------------------
# phone (default): SMS login codes (needs a real SMS provider; costs money per SMS)
# email: login codes by email (zero-cost demo mode). Email becomes the verified identity;
#        the phone number is collected but NOT verified. Use for demos, not the real pilot.
AUTH_MODE=phone
# EMAIL_PROVIDER=brevo            # brevo | resend | simulator (development only)
# BREVO_API_KEY=                  # Brevo free plan: 300 emails/day
# RESEND_API_KEY=                 # Resend free plan: 100 emails/day, needs a verified domain
# EMAIL_FROM_ADDRESS=             # the verified sender address
# EMAIL_FROM_NAME=Aarohan
# EMAIL_DAILY_CAP_TOTAL=250       # keeps you under the free plan's daily limit

# Sign in with Google (optional). Client ID only, no secret. See docs for how to create it.
GOOGLE_CLIENT_ID=

# Encrypts drivers' National ID and licence numbers. REQUIRED in production.
# Create one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KYC_ENCRYPTION_KEY=
# true = a driver can only be approved after a complete application and a fully ticked review checklist (always on in production)
STRICT_DRIVER_APPROVAL=
# Daily driver incentives (display and progress only). Example: [{"trips":10,"bonusMWK":5000}]
INCENTIVES_ENABLED=
DRIVER_INCENTIVES_JSON=

# Cash trips: a driver who owes Aarohan this much (MK) or more gets no orders until they pay. Default 2500.
MAX_COMMISSION_DEBT_MWK=2500

# ---- Driver safety (new) ----
# Nobody is approved without a complete application and a fully ticked checklist. This is ON by default everywhere.
# Only the exact value false turns it off (never do that in production).
# STRICT_DRIVER_APPROVAL=true
# When true, the admin who ticked the review checklist cannot also approve the driver: a second admin must.
# REQUIRE_TWO_PERSON_APPROVAL=false
# KYC_ENCRYPTION_KEY is REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Driver photos are saved in the PRIVATE Supabase Storage bucket named driver-documents (SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY must be set in production, there is no local fallback there).

# ---- Push notifications and ads (new) ----
# Firebase service account JSON on ONE line (for ride offers, "captain arrived", approval pushes). Without it pushes are only simulated.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Update prompts for installed apps (raise the MIN value to force very old apps to update):
# APP_RIDER_MIN_VERSION=1.0.0
# APP_DRIVER_MIN_VERSION=1.0.0
# PLAY_STORE_URL_RIDER=https://play.google.com/store/apps/details?id=com.aarohan.rider
# PLAY_STORE_URL_DRIVER=https://play.google.com/store/apps/details?id=com.aarohan.driver
# Ad pictures and videos are stored in the PUBLIC Supabase bucket named ad-media.

