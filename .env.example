# ========================================================
# AArohan Smart Urban Mobility • Environment Configuration
# Lilongwe, Malawi • Multi-Tier Mobility & Settlement Rail
# ========================================================
PORT=3000
NODE_ENV=production

# Platform Security & Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_here

# --------------------------------------------------------
# 1. Mapbox & Mapping Provider Configuration
# --------------------------------------------------------
# Map Provider: 'mapbox' (default production), 'carto', 'google', or 'maptiler'
MAP_PROVIDER=mapbox
MAP_API_KEY=your_mapbox_public_token_here
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here
GOOGLE_MAPS_API_KEY=
MAPTILER_API_KEY=

# Supabase PostgreSQL & Row Level Security (RLS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --------------------------------------------------------
# 2. Airtel Money Malawi (Airtel Africa OpenAPI v2)
# --------------------------------------------------------
# Production Base: https://openapi.airtel.africa
# Sandbox UAT Base: https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_MERCHANT_ID=
AIRTEL_MONEY_WEBHOOK_SECRET=
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa

# --------------------------------------------------------
# 3. TNM Mpamba Malawi Integration
# --------------------------------------------------------
# Open API endpoint for collections and disbursements
# Production Base: https://api.mpamba.tnm.co.mw
TNM_MPAMBA_API_KEY=
TNM_MPAMBA_MERCHANT_CODE=
TNM_MPAMBA_WEBHOOK_SECRET=
TNM_MPAMBA_BASE_URL=https://api.mpamba.tnm.co.mw

# --------------------------------------------------------
# 4. Out-of-Band SMS & WhatsApp Messaging Gateway
# --------------------------------------------------------
# Supported Providers: 'simulator', 'twilio', 'africastalking', 'tnm'
SMS_GATEWAY_PROVIDER=simulator

# Twilio SMS / WhatsApp Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Africa's Talking Credentials (Pan-African SMS Gateway)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=AAROHAN

# TNM Malawi SMS Gateway
TNM_SMS_API_KEY=
TNM_SMS_SENDER_ID=AAROHAN
TNM_SMS_BASE_URL=https://smsapi.tnm.co.mw/v1/sms/send

# --------------------------------------------------------
# 5. Malawi Emergency Hotline & Security Desk
# --------------------------------------------------------
EMERGENCY_POLICE_HOTLINE=997
AAROHAN_SECURITY_DESK_PHONE=+265991234567
